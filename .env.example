# Copy this file to .env and load it into the process environment.
# The application reads environment variables; it does not auto-load .env.
# Never commit real credentials.

# RAG Flow API
RAGFLOW_METADATA_DATABASE_URL=sqlite+pysqlite:///./data/rag-metadata.db
RAGFLOW_CHUNK_SIZE=512
RAGFLOW_CHUNK_OVERLAP=64
RAGFLOW_CHECK_ON_STARTUP=true
RAGFLOW_MAX_UPLOAD_BYTES=10485760

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3.2
OLLAMA_VERIFY_SSL=true
OLLAMA_FOLLOW_REDIRECTS=true
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

# Milvus
MILVUS_ENDPOINT=http://localhost:19530
MILVUS_DB_NAME=default
MILVUS_COLLECTION=rag_chunks
MILVUS_SECURE=false
MILVUS_CONNECT_TIMEOUT_SECONDS=10
MILVUS_REQUEST_TIMEOUT_SECONDS=30
MILVUS_MAX_RETRIES=3
# MILVUS_TOKEN=

# DMS metadata: local SQLite
DMS_METADATA_BACKEND=sqlite
DMS_SQLITE_PATH=./data/dms.db

# DMS metadata: PostgreSQL alternative
# Set DMS_METADATA_BACKEND=postgresql and uncomment these values when needed.
# DMS_POSTGRES_HOST=localhost
# DMS_POSTGRES_PORT=5432
# DMS_POSTGRES_DB=dms
# DMS_POSTGRES_USER=dms
# DMS_POSTGRES_PASSWORD=replace-me

# MinIO / DMS object storage
DMS_MINIO_ENDPOINT=localhost:9000
DMS_MINIO_ACCESS_KEY=replace-me
DMS_MINIO_SECRET_KEY=replace-me
DMS_MINIO_BUCKET=documents
DMS_MINIO_SECURE=false
